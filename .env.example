# Secret used to sign customer auth JWTs - change to a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Admin login credentials for /admin/login
ADMIN_EMAIL=admin@19store.com
ADMIN_PASSWORD=change_this_admin_password

# Secret used to sign admin session JWTs - change too
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret

# ---------------------------------------------------------------
# OPTIONAL but recommended for production: Supabase (Postgres).
# Leave these two blank/unset and the app automatically falls back
# to a local JSON file (zero setup, but not durable on Vercel).
# Set both to switch to real, persistent, shared storage.
#
# Where to find them: Supabase Dashboard -> Project Settings -> API
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key
#                                (NOT the "anon public" key)
#
# Before setting these, run supabase/schema.sql once in your
# Supabase project's SQL Editor to create the tables.
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
